{
  "kind": "collectionType",
  "collectionName": "prodotti",
  "info": {
    "singularName": "prodotto",
    "pluralName": "prodotti",
    "displayName": "Prodotto",
    "description": "Prodotti sincronizzati dal magazzino"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nome": {
      "type": "string",
      "required": true
    },
    "sku": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "descrizione": {
      "type": "text"
    },
    "prezzo_vendita": {
      "type": "decimal"
    },
    "quantita": {
      "type": "integer",
      "default": 0
    },
    "stato_conservazione": {
      "type": "string"
    },
    "lingua": {
      "type": "string"
    },
    "magazzino_id": {
      "type": "integer"
    },
    "foto": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    },
    "medusa_product_id": {
      "type": "string"
    }
  }
}
