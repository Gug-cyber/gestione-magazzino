{
  "buildCommand": "cd backend && python scripts/run_migrations.py && cd ../frontend && npm run build",
  "installCommand": "cd frontend && npm install",
  "framework": null,
  "outputDirectory": "frontend/dist",
  "builds": [
    {
      "src": "backend/app/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/dist/$1"
    }
  ]
}