DATABASE_URL=postgresql://magazzino:magazzino@db:5432/magazzino
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_LAN=true
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here
EBAY_ENV=PRODUCTION   # oppure SANDBOX per i test
EBAY_REDIRECT_URI=https://your-backend.onrender.com/api/ebay/callback
# Nota: registrare questo URI nel Developer Portal eBay come "RuName"
EBAY_VERIFICATION_TOKEN=your_verification_token_here
EBAY_DELETION_ENDPOINT_URL=https://your-backend.onrender.com/ebay/account-deletion
# Webhook vendite eBay (facoltativo ma consigliato)
EBAY_WEBHOOK_SECRET=imposta-un-secret-condiviso-per-il-webhook
# Fallback polling automatico ordini eBay
EBAY_SALES_POLLING_ENABLED=false
EBAY_SALES_POLL_INTERVAL_SECONDS=120
EBAY_SALES_POLL_LOOKBACK_HOURS=24

# Tracking Configuration
TRACKING_UPDATE_INTERVAL_HOURS=2
TRACKING_ENABLED=true

# Telegram - canale ordini (notifiche nuovo ordine, tracking, ecc.)
TELEGRAM_BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff
TELEGRAM_CHAT_ID=123456789

# Telegram - canale market intelligence (report prezzi giornaliero, occasioni marketplace)
# Può essere un bot/chat diverso dal canale ordini per tenere separati i flussi
MARKET_BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff
MARKET_CHAT_ID=123456789

# AI - Groq (LLM per analisi mercato, chat AI, previsioni stock)
# Ottieni gratuitamente su https://console.groq.com
# Se non configurato, il sistema tenta Ollama locale su http://172.17.0.1:11434
GROQ_API_KEY=gsk_...

# Optional: admin frontend URL for order links in notifications
ADMIN_BASE_URL=https://yourdomain.com

# === BACKUP & RECOVERY ===
BACKUP_TRIGGER_SECRET=your-very-long-random-secret-here
BACKUP_GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
BACKUP_STORE_GOOGLE_DRIVE_FOLDER_ID=1XyZaB...  # ID cartella Google Drive per backup store
BACKUP_RETENTION_DAYS=30

# Google Drive (Service Account) - per galleria foto prodotti
